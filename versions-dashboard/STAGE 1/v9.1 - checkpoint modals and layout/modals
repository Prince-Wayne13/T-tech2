  const [selected, setSelected] = useState(null);
  const [form, setForm] = useState({ amount: '', date: new Date().toISOString().split('T')[0], method: 'bank', ref: '', notes: '' });
  const mockRecords = [{id: 'INV-5041', title: 'Annual Report Printing', client: 'TechCorp Ltd', due: 1200000}, {id: 'JOB-2841', title: 'Product Catalog', client: 'BrandX Agency', due: 850000}];
  const filtered = mockRecords.filter(r => r.title.toLowerCase().includes(search.toLowerCase()) || r.client.toLowerCase().includes(search.toLowerCase()));

  const handleClose = () => { setCurrentStep(1); setSelected(null); setForm({ amount: '', date: new Date().toISOString().split('T')[0], method: 'bank', ref: '', notes: '' }); onClose(); };
  const handleConfirm = () => { onSave({ ...form, selectedRecord: selected }); handleClose(); };

  const isPaymentFormValid = Number(form.amount) > 0 && form.date.trim() !== '' && form.method.trim() !== '';

  return (
    <ModalWrapper isOpen={isOpen} onClose={handleClose} title="Record Payment" footer={

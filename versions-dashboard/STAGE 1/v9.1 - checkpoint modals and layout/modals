  const updateItem = (i, f, v) => setForm(p => ({...p, items: p.items.map((it, idx) => idx === i ? {...it, [f]: v} : it)}));
  const totalValue = form.items.reduce((sum, item) => sum + Number(item.amount || 0), 0);

  const handleClose = () => { setStep('form'); onClose(); };
  const handleConfirm = () => { onSave(form); setStep('form'); };

  const isFormValid = form.client.trim() !== '' && form.title.trim() !== '' && form.items.length > 0 && form.items.every(item => item.desc.trim() !== '' && Number(item.amount) > 0);

  return (
    <ModalWrapper isOpen={isOpen} onClose={handleClose} title={step === 'preview' ? "Preview Proposal" : "New Proposal"} footer={

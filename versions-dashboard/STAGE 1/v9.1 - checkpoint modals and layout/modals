          <button onClick={handleConfirm} style={{ padding: '6px 12px', borderRadius: '6px', border: 'none', background: 'var(--teal)', color: '#fff', fontSize: '10px', fontWeight: '600', cursor: 'pointer' }}>Confirm & Save</button>

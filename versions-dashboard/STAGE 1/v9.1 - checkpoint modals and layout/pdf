const fmt = (n) =>
  "MK " + Number(n || 0).toLocaleString("en-MW", { minimumFractionDigits: 0 });

const fmtDate = (d) => {
  if (!d) return "—";
  const dt = new Date(d);
  return dt.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
};

const statusColors = {
  paid:    { bg: "#dcfce7", text: "#166534" },
  sent:    { bg: "#dbeafe", text: "#1e40af" },
  overdue: { bg: "#fee2e2", text: "#991b1b" },
  draft:   { bg: "#f3f4f6", text: "#374151" },
};

function InvoiceDocument({ invoice }) {
  const {
    invoice_ref,
    client_name,
    client_address,
    client_email,
    client_phone,
    title,
    status,
    issued_on,
    due_on,
    paid_on,
    purchase_order,
    payment_terms,
    notes,
    line_items = [],
    payments = [],
    subtotal = 0,
    tax_rate = 0,
    tax_amount = 0,
    total_amount = 0,
    amount_paid = 0,
    balance_due = 0,
  } = invoice;

  const sc = statusColors[status] || statusColors.draft;

  return (
    <Document title={`${invoice_ref} – T-Tech Printing`} author="T-Tech Printing">
      <Page size="A4" style={styles.page}>

        {/* Header */}
        <View style={styles.headerRow}>
          <View>
            <Text style={styles.brandName}>T-Tech Printing</Text>
            <Text style={styles.brandSub}>MRA TIN: 1002345678</Text>
            <Text style={styles.brandSub}>Area 47, Lilongwe, Malawi</Text>
            <Text style={styles.brandSub}>+265 888 000 000 · info@ttech.mw</Text>
          </View>
          <View style={{ alignItems: "flex-end" }}>
            <View style={styles.invoiceBadge}>
              <Text style={styles.invoiceBadgeText}>INVOICE</Text>
            </View>
            <Text style={[styles.brandSub, { marginTop: 8, fontWeight: 700, color: C.navy, fontSize: 10 }]}>
              #{invoice_ref}
            </Text>
            <View style={{
              marginTop: 4,
              backgroundColor: sc.bg,
              borderRadius: 3,
              paddingHorizontal: 8,
              paddingVertical: 3,
            }}>
              <Text style={{ fontSize: 7, fontWeight: 700, color: sc.text, textTransform: "uppercase", letterSpacing: 1 }}>
                {status}
              </Text>
            </View>
          </View>
        </View>

        <View style={styles.divider} />

        {/* Meta */}
        <View style={styles.metaRow}>
          <View style={styles.metaBlock}>
            <Text style={styles.metaLabel}>Issue Date</Text>
            <Text style={styles.metaValue}>{fmtDate(issued_on)}</Text>
          </View>
          <View style={styles.metaBlock}>
            <Text style={styles.metaLabel}>Due Date</Text>
            <Text style={styles.metaValue}>{fmtDate(due_on)}</Text>
          </View>
          {paid_on && (
            <View style={styles.metaBlock}>
              <Text style={styles.metaLabel}>Paid On</Text>
              <Text style={[styles.metaValue, { color: "#16a34a" }]}>{fmtDate(paid_on)}</Text>
            </View>
          )}
          {purchase_order && (
            <View style={styles.metaBlock}>
              <Text style={styles.metaLabel}>Purchase Order</Text>
              <Text style={styles.metaValue}>{purchase_order}</Text>
            </View>
          )}
          <View style={styles.metaBlock}>
            <Text style={styles.metaLabel}>Payment Terms</Text>
            <Text style={styles.metaValueLight}>{payment_terms || "14 days"}</Text>
          </View>
        </View>

        {/* Bill To */}
        <View style={styles.billToBox}>
          <Text style={styles.billToLabel}>Bill To</Text>
          <Text style={styles.billToName}>{client_name}</Text>
          {client_address && <Text style={styles.billToSub}>{client_address}</Text>}
          {client_email  && <Text style={styles.billToSub}>{client_email}</Text>}
          {client_phone  && <Text style={styles.billToSub}>{client_phone}</Text>}
          {title && <Text style={[styles.billToSub, { marginTop: 4, fontWeight: 700 }]}>{title}</Text>}
        </View>

        {/* Table */}
        <View style={styles.tableHeader}>
          <Text style={[styles.tableHeaderText, styles.colDesc]}>Description</Text>
          <Text style={[styles.tableHeaderText, styles.colQty]}>Qty</Text>
          <Text style={[styles.tableHeaderText, styles.colRate]}>Rate</Text>
          <Text style={[styles.tableHeaderText, styles.colAmount]}>Amount</Text>
        </View>

        {line_items.map((item, i) => (
          <View key={i} style={[styles.tableRow, i % 2 === 1 && styles.tableRowAlt]}>
            <View style={styles.colDesc}>
              <Text style={styles.cellText}>{item.description}</Text>
              {item.product_type && (
                <Text style={styles.cellTextMuted}>{item.product_type}</Text>
              )}
            </View>
            <Text style={[styles.cellText, styles.colQty]}>
              {item.quantity} {item.unit || ""}
            </Text>
            <Text style={[styles.cellText, styles.colRate]}>{fmt(item.unit_price)}</Text>
            <Text style={[styles.cellText, styles.colAmount]}>
              {fmt((item.quantity || 0) * (item.unit_price || 0))}
            </Text>
          </View>
        ))}

        {/* Totals */}
        <View style={styles.totalsSection}>
          <View style={styles.totalsBox}>
            <View style={styles.totalsRow}>
              <Text style={styles.totalsLabel}>Subtotal</Text>
              <Text style={styles.totalsValue}>{fmt(subtotal || total_amount)}</Text>
            </View>
            {tax_rate > 0 && (
              <View style={styles.totalsRow}>
                <Text style={styles.totalsLabel}>VAT ({(tax_rate * 100).toFixed(0)}%)</Text>
                <Text style={styles.totalsValue}>{fmt(tax_amount)}</Text>
              </View>
            )}
            <View style={styles.totalsDivider} />
            <View style={styles.grandTotalRow}>
              <Text style={styles.grandTotalLabel}>Total</Text>
              <Text style={styles.grandTotalValue}>{fmt(total_amount)}</Text>
            </View>
          </View>
        </View>

        {/* Payments received */}
        {payments.length > 0 && (
          <View style={styles.paymentsBox}>
            <Text style={styles.paymentsTitle}>Payments Received</Text>
            {payments.map((p, i) => (
              <View key={i} style={styles.paymentRow}>
                <Text style={styles.paymentText}>
                  {fmtDate(p.paid_on)} · {p.method?.replace("_", " ")} · {p.received_by}
                </Text>
                <Text style={[styles.paymentText, { fontWeight: 700 }]}>{fmt(p.amount)}</Text>
              </View>
            ))}
          </View>
        )}

        {/* Balance Due */}
        {balance_due > 0 && (
          <View style={styles.balanceBox}>
            <Text style={styles.balanceLabel}>Balance Due</Text>
            <Text style={styles.balanceValue}>{fmt(balance_due)}</Text>
          </View>
        )}

        {/* Notes */}
        {notes && (
          <View style={{ marginTop: 20 }}>
            <Text style={[styles.metaLabel, { marginBottom: 4 }]}>Notes</Text>
            <Text style={[styles.cellText, { color: C.gray, lineHeight: 1.5 }]}>{notes}</Text>
          </View>
        )}

        {/* Footer */}
        <View style={styles.footer} fixed>
          <Text style={styles.footerText}>Thank you for choosing T-Tech Printing · ttech.mw</Text>
          <Text style={styles.footerRef}>{invoice_ref}</Text>
          <Text style={styles.footerText}>Page 1</Text>
        </View>

      </Page>
    </Document>
  );
}

export async function downloadInvoicePDF(invoice) {
  const blob = await pdf(<InvoiceDocument invoice={invoice} />).toBlob();
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `${invoice.invoice_ref}.pdf`;
  a.click();
  URL.revokeObjectURL(url);
}

export default InvoiceDocument;




